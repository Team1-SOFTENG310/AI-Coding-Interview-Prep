<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.TextFlow?>

<BorderPane fx:id="savedRoot" prefHeight="760" prefWidth="1200" stylesheets="@../css/main.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.aicodinginterviewprep.controllers.HistoryController">

   <padding>
      <Insets bottom="16" left="16" right="16" top="16" />
   </padding>

   <top>
      <HBox alignment="CENTER_LEFT" spacing="10">
         <Label styleClass="title-label" text="History" />
         <Region prefHeight="46.0" prefWidth="0.0" HBox.hgrow="ALWAYS" />
         <Button fx:id="buttonBack" mnemonicParsing="false" onAction="#onBack" text="Back" />
      </HBox>
   </top>

   <left>
      <VBox spacing="4.0">
         <padding>
            <Insets bottom="8" left="8" right="8" top="8" />
         </padding>
         <Label styleClass="section-label" text="Session Dates" />
         <ListView fx:id="listQuestions" prefWidth="420.0" VBox.vgrow="ALWAYS" />
      </VBox>
   </left>

   <center>
      <VBox spacing="4.0">
         <padding>
            <Insets bottom="8" left="8" right="8" top="8" />
         </padding>
         <Label styleClass="section-label" text="Topics" />
         <TextFlow fx:id="textFlowTopics" prefHeight="307.0" prefWidth="716.0" />
         <Label styleClass="section-label" text="Scores" />
         <TextFlow fx:id="textFlowScores" layoutX="18.0" layoutY="52.0" prefHeight="365.0" prefWidth="716.0" />
      </VBox>
   </center>

</BorderPane>
