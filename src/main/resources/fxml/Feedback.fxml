<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.aicodinginterviewprep.controllers.FeedbackController">
   <children>
      <Pane prefHeight="400.0" prefWidth="600.0">
         <children>
            <Label layoutX="159.0" layoutY="58.0" styleClass="title-label" text="Evaluation Summary">
               <font>
                  <Font name="Bodoni MT" size="30.0" />
               </font>
            </Label>
            <TextArea fx:id="textareaEvaluation" editable="false" layoutX="65.0" layoutY="131.0" prefHeight="190.0" prefWidth="470.0" />
            <Button fx:id="buttonTryAgain" layoutX="159.0" layoutY="334.0" mnemonicParsing="false" onAction="#onTryAgain" text="Try Another Question" />
            <Button fx:id="buttonSubmitAnswer" layoutX="307.0" layoutY="334.0" mnemonicParsing="false" prefHeight="25.0" prefWidth="130.0" text="Submit Answer" />
         </children>
      </Pane>
   </children>
</AnchorPane>
