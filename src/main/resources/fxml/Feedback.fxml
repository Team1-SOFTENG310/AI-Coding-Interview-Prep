                  <Font name="Bodoni MT" size="30.0" />
               </font>
            </Label>
            <TextArea fx:id="textareaEvaluation" editable="false" layoutX="65.0" layoutY="131.0" prefHeight="190.0" prefWidth="470.0" />
            <Button fx:id="buttonTryAgain" layoutX="235.0" layoutY="343.0" mnemonicParsing="false" onAction="#onTryAgain" text="Try Another Question" />
