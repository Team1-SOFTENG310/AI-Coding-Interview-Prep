<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" stylesheets="@../css/main.css" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.aicodinginterviewprep.controller.FeedbackController">
   <children>
      <Pane prefHeight="400.0" prefWidth="600.0">
         <children>
            <VBox layoutX="51.0" layoutY="29.0" prefHeight="348.0" prefWidth="507.0" styleClass="vbox">
               <children>
                  <Label styleClass="title-label" text="Evaluation Summary">
                     <font>
                        <Font name="Bodoni MT" size="30.0" />
                     </font>
                  </Label>
                  <Pane prefHeight="22.0" prefWidth="490.0" />
                  <TextArea fx:id="textareaEvaluation" editable="false" prefHeight="190.0" prefWidth="470.0" />
                  <Button fx:id="buttonTryAgain" maxWidth="216.0" mnemonicParsing="false" onAction="#onTryAgain" prefHeight="46.0" prefWidth="216.0" text="Try Another Question" />
               </children>
            </VBox>
         </children>
      </Pane>
   </children>
</AnchorPane>
