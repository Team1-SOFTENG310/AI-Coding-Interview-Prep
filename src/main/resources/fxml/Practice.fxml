<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="practiceRoot" prefHeight="760" prefWidth="1200" stylesheets="@../css/main.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.aicodinginterviewprep.controllers.PracticeController">

   <padding>
      <Insets bottom="16" left="16" right="16" top="16" />
   </padding>

   <!-- ===== Question output (40% width, set in initialize) ===== -->
   <left>
      <VBox>
         <padding>
            <Insets bottom="8" left="8" right="8" top="8" />
         </padding>
         <Label styleClass="section-label" text="Question" />
         <TextArea fx:id="questionOutput" editable="false" prefHeight="634.0" prefRowCount="8" prefWidth="322.0" promptText="Generate a question to begin." styleClass="question-label" wrapText="true" VBox.vgrow="ALWAYS" />
      </VBox>
   </left>

   <!-- ===== Code editor (40% width, set in initialize) ===== -->
   <center>
      <VBox>
         <padding>
            <Insets bottom="8" left="8" right="8" top="8" />
         </padding>
         <Label styleClass="section-label" text="Code editor" />
         <TextArea fx:id="codeEditor" prefHeight="633.0" prefRowCount="20" prefWidth="493.0" text="// Write your code here" wrapText="true" VBox.vgrow="ALWAYS" />
      </VBox>
   </center>

   <!-- ===== Answer submission (remaining ~20%) ===== -->
   <right>
      <VBox>
         <padding>
            <Insets bottom="8" left="8" right="8" top="8" />
         </padding>
         <Label styleClass="section-label" text="Your explanation" />
         <TextField fx:id="answerInput" prefHeight="182.0" prefWidth="194.0" promptText="Explain your solution" />
         <Button fx:id="buttonSubmitAnswer" maxWidth="Infinity" onAction="#onSubmitAnswer" text="Submit answer" />
      </VBox>
   </right>

   <!-- ===== Action bar ===== -->
   <bottom>
      <HBox prefHeight="38.0" prefWidth="1023.0">
         <padding>
            <Insets left="8" right="8" top="12" />
         </padding>
         <ComboBox fx:id="comboQuestionType" prefWidth="200" />
         <Button fx:id="buttonGenerateQuestion" onAction="#onGenerateQuestion" text="Generate new question" />
         <Button fx:id="buttonRunEvaluation" onAction="#runEvaluation" text="Run AI evaluation" />
         <Button fx:id="buttonReturn" mnemonicParsing="false" onAction="#onReturn" prefHeight="26.0" prefWidth="102.0" text="Return" />
      </HBox>
   </bottom>

</BorderPane>
