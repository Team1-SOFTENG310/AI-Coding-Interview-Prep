<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="practiceRoot" prefHeight="760" prefWidth="1200" stylesheets="@../css/main.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.aicodinginterviewprep.controllers.PracticeController">

   <padding>
      <Insets bottom="16" left="16" right="16" top="16" />
   </padding>

   <top>
      <HBox alignment="CENTER_LEFT" spacing="10">
         <Button fx:id="buttonLogOut" mnemonicParsing="false" onAction="#onLogOut" text="Log Out" />
         <Label fx:id="labelLoggedInAs" styleClass="muted-label" />
         <Region HBox.hgrow="ALWAYS" />
         <Label fx:id="labelSaveStatus" styleClass="muted-label" />
         <Button fx:id="buttonSave" disable="true" onAction="#onSave" text="Save" />
         <Button mnemonicParsing="false" onAction="#onSavedQuestions" text="Saved Questions" />
      </HBox>
   </top>

   <!-- ===== Question output ===== -->
   <left>
      <VBox spacing="4.0">
         <padding>
            <Insets bottom="8" left="8" right="8" top="8" />
         </padding>
         <HBox alignment="CENTER_LEFT" minHeight="-Infinity" prefHeight="45.0" prefWidth="200.0">
            <children>
               <Label styleClass="section-label" text="Question" />
               <Region prefHeight="45.0" prefWidth="54.0" />
               <ComboBox fx:id="comboQuestionType" prefWidth="260" promptText="Question type" />
            </children>
         </HBox>
         <TextArea fx:id="questionOutput" editable="false" mouseTransparent="true" prefHeight="634.0" prefRowCount="8" prefWidth="400.0" promptText="Generate a question to begin." styleClass="question-label" wrapText="true" VBox.vgrow="ALWAYS" />
      </VBox>
   </left>

   <!-- ===== Explanation (fills the remaining space) ===== -->
   <center>
      <VBox spacing="4">
         <padding>
            <Insets bottom="8" left="8" right="8" top="8" />
         </padding>
         <HBox alignment="CENTER_LEFT" spacing="10">
            <Label styleClass="section-label" text="Your explanation" />
            <Label fx:id="labelVoiceStatus" styleClass="voice-status-label" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="buttonVoiceInput" disable="true" mnemonicParsing="false" onAction="#onVoiceInput" text="Record Answer" />
         </HBox>
         <TextArea fx:id="answerInput" disable="true" prefHeight="633.0" prefRowCount="20" promptText="Generate a question first to start answering." wrapText="true" VBox.vgrow="ALWAYS" />
      </VBox>
   </center>

   <!-- ===== Action bar ===== -->
   <bottom>
      <HBox alignment="CENTER_LEFT" prefHeight="38.0" prefWidth="1023.0">
         <padding>
            <Insets left="8" right="8" top="12" />
         </padding>
         <ComboBox fx:id="comboTopic" prefWidth="210" promptText="Topic" />
         <ComboBox fx:id="comboDifficulty" prefWidth="150" promptText="Difficulty" />
         <Button fx:id="buttonGenerateQuestion" onAction="#onGenerateQuestion" text="Generate new question" />
         <Button fx:id="buttonCodingPractice" onAction="#onCodingPractice" text="Code Practice" />
         <Region HBox.hgrow="ALWAYS" />
         <Button fx:id="buttonSubmitAnswer" onAction="#onSubmitAnswer" text="Submit answer" />
      </HBox>
   </bottom>

</BorderPane>
