            <Button fx:id="buttonGetStarted" layoutX="155.0" layoutY="278.0" mnemonicParsing="false" onAction="#onGetStarted" prefHeight="33.0" prefWidth="111.0" text="Get Started!" />
            <Button fx:id="buttonSignIn" layoutX="334.0" layoutY="278.0" mnemonicParsing="false" onAction="#onSignIn" prefHeight="32.0" prefWidth="111.0" text="Sign In" />
