<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="CONTROLLER_NAME">
   <children>
      <Pane prefHeight="400.0" prefWidth="600.0">
         <children>
            <Label layoutX="136.0" layoutY="96.0" text="Coding Interview Practice">
               <font>
                  <Font name="Bodoni MT" size="30.0" />
               </font>
            </Label>
            <Label layoutX="199.0" layoutY="145.0" text="Welcome to AI Coding Interview Prep!" />
            <Label layoutX="122.0" layoutY="162.0" text="Go to Practice to answer coding questions and receive AI feedback." />
            <Label layoutX="155.0" layoutY="179.0" text="Login or register to save progress in later assignments." />
            <Button fx:id="buttonGetStarted" layoutX="184.0" layoutY="278.0" mnemonicParsing="false" onAction="#onGetStarted" prefWidth="80.0" text="Get Started!" />
            <Button fx:id="buttonSignIn" layoutX="331.0" layoutY="278.0" mnemonicParsing="false" onAction="#onSignIn" prefWidth="80.0" text="Sign In" />
         </children></Pane>
   </children>
</AnchorPane>
